{
  "name": "xordium-website-5-0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev src/frontend",
    "build": "npm run db:generate && next build src/frontend",
    "start": "next start src/frontend",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema src/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema src/backend/prisma/schema.prisma",
    "db:seed": "tsx src/backend/scripts/seed.ts",
    "db:studio": "prisma studio --schema src/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@fontsource/anybody": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
