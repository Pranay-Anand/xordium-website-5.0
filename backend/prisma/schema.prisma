generator client {
  provider = "sqlite"
  output   = "./node_modules/@prisma/client/lib"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id        String   @id @default(uuid())
  slug      String   @unique
  tag       String
  title     String
  category  String
  description String
  image     String
  prizePool String
  venue     String
  format    String
  schedule  String
  teamSize  String?
  cta       String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @fields([eventId])
  email      String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}